	"item": [
		{
			"name": "Get all products",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has products array\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('products');",
							"    pm.expect(jsonData.products).to.be.an('array');",
							"});",
							"",
							"pm.test(\"All products have required fields\", function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.products.forEach(product => {",
							"        pm.expect(product).to.have.property('id');",
							"        pm.expect(product).to.have.property('title');",
							"        pm.expect(product).to.have.property('variants');",
							"    });",
							"});",
							"",
							"pm.test(\"All active products have at least one variant with a price\", function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.products.forEach(product => {",
							"        if (product.status === 'active') {",
							"            pm.expect(product.variants.length).to.be.greaterThan(0);",
							"            product.variants.forEach(variant => {",
							"                pm.expect(parseFloat(variant.price)).to.be.greaterThan(0);",
							"            });",
							"        }",
							"    });",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Shopify-Access-Token",
						"value": "{{access_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "https://{{shop_url}}/admin/api/{{api_version}}/products.json",
					"protocol": "https",
					"host": [
						"{{shop_url}}"
					],
					"path": [
						"admin",
						"api",
						"{{api_version}}",
						"products.json"
					]
				}
			},
			"response": []
		},
